# Line endings, fixed here so that a clone gives the same bytes on any machine.
#
# This matters more than usual: tools/parche_uwp_build.py and tools/resolver_conflictos.py match
# anchors against files in the game's tree and its submodules, and an anchor that does not match
# the tree byte for byte does not apply. Leaving it to each machine's core.autocrlf would make
# "did the recipe reproduce the tree?" depend on who cloned it.

*               text=auto eol=lf

# PowerShell is happier with CRLF on Windows, and these scripts only ever run there.
*.ps1           text eol=crlf

# cmd.exe splits a .bat saved with LF in the wrong places: CRLF, always.
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Shell scripts must be LF, or the shebang line carries a stray \r and the script will not run.
*.sh            text eol=lf

# Python: the anchors inside these files have to survive a clone unchanged.
*.py            text eol=lf

# A patch has to match the endings of the tree it is applied to, and upstream is LF.
*.patch         text eol=lf
*.diff          text eol=lf

# Markdown, CMake and plain config: LF, like everything else.
*.md            text eol=lf
*.cmake         text eol=lf
*.toml          text eol=lf
*.appxmanifest  text eol=lf

# Images are bytes: git must neither convert them nor try to diff them.
*.png           binary
*.jpg           binary
*.ico           binary
